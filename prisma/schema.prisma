datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                         String   @id @default(cuid())
  email                      String   @unique
  passwordHash               String
  name                       String
  timezone                   String   @default("UTC")
  isEmailVerified            Boolean  @default(false)
  emailVerifyToken           String?  @unique
  emailVerifyExpiresAt       DateTime?
  resetPasswordToken         String?  @unique
  resetPasswordExpiresAt     DateTime?
  quietHoursStart            String   @default("22:00")
  quietHoursEnd              String   @default("08:00")
  browserNotificationsEnabled Boolean  @default(false)
  dashboardCardOrder         String   @default("tasks,applications,interviews,courses,goals,activity")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  sessions                   Session[]
  workspaceMemberships       WorkspaceMember[]
  ownedWorkspaces            Workspace[]        @relation("WorkspaceOwner")
  sentInvitations            WorkspaceInvitation[] @relation("SentInvitations")
  createdTasks               Task[]             @relation("TaskCreator")
  assignedTasks              Task[]             @relation("TaskAssignee")
  taskComments               TaskComment[]
  taskActivities             TaskActivity[]
  jobApplications            JobApplication[]
  courses                    Course[]
  studySessions              StudySession[]
  savedLinks                 SavedLink[]
  dailyGoalSessions          DailyGoalSession[]
  activeTimer                ActiveTimer?
  reminders                  Reminder[]
  notifications              Notification[]
  workspaceActivities        WorkspaceActivity[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  ownerId     String
  owner       User     @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  projects    Project[]
  tasks       Task[]
  activities  WorkspaceActivity[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("MEMBER") // OWNER, ADMIN, MEMBER, VIEWER
  joinedAt    DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

model WorkspaceInvitation {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        String    @default("MEMBER") // ADMIN, MEMBER, VIEWER
  token       String    @unique
  invitedById String
  invitedBy   User      @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  status      String    @default("PENDING") // PENDING, ACCEPTED, REVOKED, DECLINED
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([email])
}

model Project {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String    @default("#0c87eb")
  isArchived  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks       Task[]

  @@index([workspaceId])
}

model Task {
  id                     String    @id @default(cuid())
  title                  String
  description            String?
  status                 String    @default("TODO") // TODO, IN_PROGRESS, BLOCKED, DONE
  priority               String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  blockerReason          String?
  dueDate                DateTime?
  tags                   String?   // comma-separated tags
  recurrenceRule         String?   // NONE, DAILY, WEEKLY, MONTHLY
  parentTaskId           String?
  parentTask             Task?     @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks               Task[]    @relation("SubTasks")

  workspaceId            String?
  workspace              Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId              String?
  project                Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)

  creatorId              String
  creator                User      @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assigneeId             String?
  assignee               User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  isArchived             Boolean   @default(false)

  // Cross-module connections
  linkedJobApplicationId String?
  linkedJobApplication   JobApplication? @relation(fields: [linkedJobApplicationId], references: [id], onDelete: SetNull)
  linkedCourseId         String?
  linkedCourse           Course?         @relation(fields: [linkedCourseId], references: [id], onDelete: SetNull)
  linkedSavedLinkId      String?
  linkedSavedLink        SavedLink?      @relation(fields: [linkedSavedLinkId], references: [id], onDelete: SetNull)

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  comments               TaskComment[]
  activities             TaskActivity[]
  attachments            TaskAttachment[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([status])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  mentions  String?  // JSON list of userIds
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([authorId])
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name      String
  url       String
  size      Int?
  type      String?
  createdAt DateTime @default(now())

  @@index([taskId])
}

model JobApplication {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String
  roleTitle          String
  jobUrl             String?
  jobDescription     String?
  location           String?
  workArrangement    String   @default("NOT_SPECIFIED") // REMOTE, HYBRID, ON_SITE, NOT_SPECIFIED
  employmentType     String   @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, INTERNSHIP, OTHER
  salaryRange        String?
  currency           String   @default("USD")
  dateFound          DateTime?
  applicationDate    DateTime?
  contactName        String?
  contactDetails     String?
  notes              String?
  nextFollowUpDate   DateTime?
  resumeUrl          String?
  resumeVersion      String?
  coverLetterUrl     String?
  coverLetterVersion String?
  stage              String   @default("SAVED") // SAVED, PREPARING, APPLIED, INTERVIEWING, OFFER, REJECTED, WITHDRAWN
  isArchived         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  interviewRounds    InterviewRound[]
  activities         JobApplicationActivity[]
  linkedTasks        Task[]

  @@index([userId])
  @@index([stage])
}

model InterviewRound {
  id               String         @id @default(cuid())
  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  roundTitle       String
  interviewDate    DateTime
  timezone         String         @default("UTC")
  format           String         @default("Video (Google Meet)")
  interviewer      String?
  preparationNotes String?
  outcome          String         @default("SCHEDULED") // SCHEDULED, PASSED, FAILED, PENDING
  remindersSent    Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([jobApplicationId])
  @@index([interviewDate])
}

model JobApplicationActivity {
  id               String         @id @default(cuid())
  jobApplicationId String
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  action           String
  details          String?
  createdAt        DateTime       @default(now())

  @@index([jobApplicationId])
}

model Course {
  id                   String          @id @default(cuid())
  userId               String
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  provider             String?
  subjectCategory      String?
  courseUrl            String?
  description          String?
  targetCompletionDate DateTime?
  status               String          @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, PAUSED, COMPLETE
  notes                String?
  questions            String?
  keyTakeaways         String?
  isArchived           Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  sections             CourseSection[]
  lessons              Lesson[]
  studySessions        StudySession[]
  linkedTasks          Task[]

  @@index([userId])
  @@index([status])
}

model CourseSection {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title      String
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lessons    Lesson[]

  @@index([courseId])
}

model Lesson {
  id           String         @id @default(cuid())
  courseId     String
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sectionId    String?
  section      CourseSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title        String
  resourceUrl  String?
  status       String         @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETE
  notes        String?
  orderIndex   Int            @default(0)
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([courseId])
  @@index([sectionId])
}

model StudySession {
  id              String   @id @default(cuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt       DateTime
  endedAt         DateTime
  durationMinutes Int
  notes           String?
  createdAt       DateTime @default(now())

  @@index([courseId])
  @@index([userId])
}

model SavedLink {
  id                       String             @id @default(cuid())
  userId                   String
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                    String
  url                      String
  description              String?
  category                 String             @default("Documentation") // YouTube, LeetCode, Courses, Job Search, Documentation, Custom
  customCategory           String?
  dailyGoalDurationMinutes Int?               @default(30)
  isPinned                 Boolean            @default(false)
  sortOrder                Int                @default(0)
  isArchived               Boolean            @default(false)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  dailySessions            DailyGoalSession[]
  activeTimers             ActiveTimer[]
  linkedTasks              Task[]

  @@index([userId])
  @@index([category])
}

model DailyGoalSession {
  id              String    @id @default(cuid())
  savedLinkId     String
  savedLink       SavedLink @relation(fields: [savedLinkId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int       @default(0)
  isCompleted     Boolean   @default(false)
  sessionDate     String    // YYYY-MM-DD
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([savedLinkId])
  @@index([userId])
  @@index([sessionDate])
}

model ActiveTimer {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedLinkId        String
  savedLink          SavedLink @relation(fields: [savedLinkId], references: [id], onDelete: Cascade)
  startedAt          DateTime
  accumulatedSeconds Int       @default(0)
  isPaused           Boolean   @default(false)
  pausedAt           DateTime?
  targetSeconds      Int       @default(1800)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
}

model Reminder {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  targetType   String    // TASK, INTERVIEW, FOLLOW_UP, COURSE, DAILY_GOAL
  targetId     String
  remindAt     DateTime
  isCompleted  Boolean   @default(false)
  isSnoozed    Boolean   @default(false)
  snoozedUntil DateTime?
  isDismissed  Boolean   @default(false)
  frequency    String    @default("ONCE") // ONCE, DAILY, WEEKDAYS
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([remindAt])
  @@index([isCompleted])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, ASSIGNMENT, MENTION, REMINDER
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model WorkspaceActivity {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  details     String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
}

